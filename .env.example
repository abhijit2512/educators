# --- App ---
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://educatorsunited.in
NEXTAUTH_URL=https://educatorsunited.in
# Generate with:  openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-long-random-string

# --- Database (PostgreSQL on Supabase) ---
# Use the Supabase "Connection string" (URI). Format:
# postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# Tip: for serverless/pooled connections use Supabase's pooler URL (port 6543)
# and append ?pgbouncer=true ; for migrations use the direct URL (port 5432).
DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres

# --- Admin bootstrap (used by prisma/seed.ts) ---
# These become your admin login at /login. The seed script prints them.
ADMIN_EMAIL=admin@educatorsunited.in
ADMIN_PASSWORD=change-me-on-first-login
ADMIN_NAME=Site Admin

# --- Business contact defaults (admin can edit later in dashboard) ---
BUSINESS_NAME=Educators United Pvt Ltd
BUSINESS_EMAIL=hello@educatorsunited.in
BUSINESS_PHONE=+44 0000 000000
BUSINESS_WHATSAPP=+44 0000 000000
BUSINESS_FACEBOOK=https://facebook.com/educatorsunited
BUSINESS_LOGO_URL=/logo.png

# --- Email (Nodemailer / SMTP) ---
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=postmaster@educatorsunited.in
SMTP_PASS=replace-me
SMTP_FROM="Educators United <noreply@educatorsunited.in>"

# --- Stripe (optional - leave blank to disable) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- PayPal (optional - leave blank to disable) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Also expose the client ID to the browser so the PayPal Buttons SDK can
# render. Safe to be public — only the SECRET must stay server-only.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# --- Twilio SMS (optional placeholder) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- WhatsApp Business API (optional) ---
# When these are set, the admin gets a WhatsApp message on every new enquiry.
# WHATSAPP_API_URL is your provider's send endpoint (e.g. Meta Cloud API or
# a gateway like 360dialog / Twilio WhatsApp). WHATSAPP_ADMIN_TO overrides the
# business WhatsApp number set in admin settings, if you want alerts elsewhere.
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_FROM=
WHATSAPP_ADMIN_TO=
