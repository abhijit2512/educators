# --- App ---
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXTAUTH_URL=https://your-domain.com
# Generate with:  openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-long-random-string

# --- Database (MySQL on Hostinger) ---
# Format: mysql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=mysql://user:password@localhost:3306/educators

# --- Admin bootstrap (used by prisma/seed.ts) ---
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=change-me-on-first-login
ADMIN_NAME=Site Admin

# --- Business contact defaults (admin can edit later in dashboard) ---
BUSINESS_NAME=Academic Support Brand
BUSINESS_EMAIL=hello@your-domain.com
BUSINESS_PHONE=+44 0000 000000
BUSINESS_WHATSAPP=+44 0000 000000
BUSINESS_FACEBOOK=https://facebook.com/your-page

# --- Email (Nodemailer / SMTP) ---
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=postmaster@your-domain.com
SMTP_PASS=replace-me
SMTP_FROM="Academic Support <noreply@your-domain.com>"

# --- Stripe (optional - leave blank to disable) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- PayPal (optional - leave blank to disable) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# --- Twilio SMS (optional placeholder) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- WhatsApp Business API (optional placeholder) ---
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_FROM=
